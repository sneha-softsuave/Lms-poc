# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Defense AI LMS (POC)
DEBUG=false

# ── Database (PostgreSQL / asyncpg) ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://poc:poc@localhost:5432/defense_lms

# ── Security / JWT ────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-in-prod-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── Bootstrap admin (created on first startup) ────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@defense-lms.org
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# ── Model Gateway (PRD 4.9) — the ONLY place AI providers are chosen ──────────
# cloud  -> hosted Anthropic Claude + local MiniLM embeddings
# openai -> OpenAI GPT + OpenAI embeddings (only needs the openai package + key)
# local  -> vLLM/Ollama + BGE/E5 (air-gapped; implemented in the hardening phase)
MODEL_PROVIDER=cloud
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
GATEWAY_MAX_TOKENS=2048
GATEWAY_TEMPERATURE=0.0

# OpenAI provider (set MODEL_PROVIDER=openai to use these)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# Local provider (air-gap phase)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# ── Vector store (Qdrant) + embeddings ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS is reported by the gateway; Qdrant collection follows it.

# ── Object storage (MinIO, S3-compatible; local-only, no CDN) ─────────────────
STORAGE_PROVIDER=minio
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defense-lms
LOCAL_STORAGE_PATH=media

# ── Content extraction / OCR ──────────────────────────────────────────────────
CONTENT_EXTRACTION_MAX_FILE_SIZE=20971520
TESSERACT_PATH=
POPPLER_PATH=
